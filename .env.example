# Copy to .env to keep bots and chats in a Supabase account instead of .local/settings.json.
# Leave both empty (or delete .env) to run fully locally.
# Both values are in Supabase: Project Settings -> API. Use the publishable (anon) key,
# never the secret / service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
